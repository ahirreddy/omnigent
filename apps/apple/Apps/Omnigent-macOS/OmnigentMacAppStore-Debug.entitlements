<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Debug builds are ad-hoc signed, and Xcode refuses keychain-access-groups without a
	development certificate, so this file is the Release entitlements minus that group. Debug
	stores credentials in the login keychain instead (KeychainModeSelection). Keep every other
	key identical to OmnigentMacAppStore.entitlements.
	-->
	<!--
	Mac App Store edition: App Sandbox with outgoing connections. It does not embed CEF and reads
	managed preferences only from its own domain, so it needs no temporary exceptions.
	-->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!--
	Browser sign-in (OIDC and Databricks) receives its redirect on an ephemeral loopback port
	(RFC 8252), which the sandbox allows only with the server entitlement.
	-->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Web pages may use the camera, microphone and location after the user allows it. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
