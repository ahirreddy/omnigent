<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Developer ID edition: no App Sandbox, because it launches the Chromium web host, which
	inherits the app's sandbox, and Chromium's helper sandbox cannot nest inside App Sandbox
	(see Packages/OmnigentWebLayer/DESIGN.md). It ships with hardened runtime and notarization
	instead. The network client key has no effect without the sandbox
	and is kept so the two editions declare the same network use.
	-->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Web pages may use the camera, microphone and location after the user allows it. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!--
	The data-protection keychain, where the core keeps sign-in credentials. Without this group
	macOS answers errSecMissingEntitlement (-34018). The group is the app's own application
	identifier, which every provisioning profile for the bundle allows. Release only: ad-hoc signed
	Debug builds use OmnigentMac-Debug.entitlements and the login keychain (KeychainModeSelection).
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
</dict>
</plist>
