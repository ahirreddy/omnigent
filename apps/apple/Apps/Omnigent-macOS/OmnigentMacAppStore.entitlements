<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Mac App Store edition: App Sandbox with outgoing connections. It does not embed CEF and reads
	managed preferences only from its own domain, so it needs no temporary exceptions.
	-->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!--
	Browser sign-in (OIDC and Databricks) receives its redirect on an ephemeral loopback port
	(RFC 8252), which the sandbox allows only with the server entitlement.
	-->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Web pages may use the camera, microphone and location after the user allows it. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!--
	The data-protection keychain, where the core keeps sign-in credentials. Without this group
	macOS answers errSecMissingEntitlement (-34018). The group is the app's own application
	identifier, which every provisioning profile for the bundle allows. Release only: ad-hoc signed
	Debug builds use OmnigentMacAppStore-Debug.entitlements and credential files
	(KeychainModeSelection).
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
</dict>
</plist>
