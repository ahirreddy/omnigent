# Copy to apps/apple/fastlane/.env and fill in. Never commit the real values, the .p8 or the
# Sparkle key. CI sets the same variables from repository secrets (see apps/apple/RELEASE.md).

# App Store Connect API key (Users and Access > Integrations > App Store Connect API,
# role App Manager). Used for uploads, build numbers and notarization.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_PATH=./fastlane/AuthKey_XXXXXXXXXX.p8

# Only if the Apple ID belongs to more than one App Store Connect team.
# ASC_TEAM_ID=xxxxxxxx

# Developer ID edition (mac developer_id).
# OMNIGENT_DEVELOPER_ID_IDENTITY="Developer ID Application: Databricks, Inc. (8RMX4WU6F8)"
# OMNIGENT_SIGNING_KEYCHAIN=/path/to/signing.keychain-db
# Base64 private EdDSA key from `generate_keys -x`; prefer exporting it in the shell only for
# the release, rather than keeping it in this file.
# SPARKLE_ED_PRIVATE_KEY=
# OMNIGENT_SPARKLE_DOWNLOAD_URL_PREFIX=https://<store>.public.blob.vercel-storage.com/native-mac/
# OMNIGENT_RELEASE_NOTES=./release-notes.md
# First release only: OMNIGENT_BUILD_NUMBER=1 and OMNIGENT_SPARKLE_NEW_FEED=1

# Store editions in CI: installed App Store provisioning profiles (manual signing). Leave unset
# on a Mac signed into Xcode to use automatic signing.
# OMNIGENT_MAC_APP_STORE_PROFILE_PATH=/path/to/OmnigentMacAppStore.provisionprofile
# OMNIGENT_IOS_APP_STORE_PROFILE_PATH=/path/to/OmnigentiOS.mobileprovision
