+/// Retry a frame dropped while every target was in use, one display refresh
+/// later. Without a display link nothing else would draw it.
+fn retryWhenTargetsFree(self: *Thread) void {
+    if (self.externalDrainActive() or self.renderer.hasVsync()) return;
+    if (self.targets_in_use_retry_c.state() == .active) return;
+    self.targets_in_use_retry_h.run(
+        &self.loop,
+        &self.targets_in_use_retry_c,
+        DRAW_INTERVAL,
+        Thread,
+        self,
+        targetsInUseRetryCallback,
+    );
+}
+
+fn targetsInUseRetryCallback(
+    self_: ?*Thread,
+    _: *xev.Loop,
+    _: *xev.Completion,
+    r: xev.Timer.RunError!void,
+) xev.CallbackAction {
+    _ = r catch |err| {
+        log.warn("error in targets-in-use retry timer err={}", .{err});
+        return .disarm;
+    };
+    const t = self_ orelse return .disarm;
+    if (t.externalDrainActive()) return .disarm;
+    _ = t.drawFrame(true);
+    return .disarm;
+}
